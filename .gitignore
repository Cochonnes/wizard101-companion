# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment (each user creates their own via install.bat)
venv/

# User data - never overwrite on git pull
boss_wiki.db
hud_settings.json
keybinds.json
world_order.json

# Logs
*.log

# EasyOCR model cache
.EasyOCR/

# Generated Cloudflare-alert default chime (regenerated on demand)
#sounds/

# Scraped spell caches + images (re-downloadable from the wiki)
spell_cache/
spell_html_cache/
spell_images/
spell_images_fusion/
wikitext_cache/

# PyInstaller (if you ever try again)
build/
dist/
*.spec

# Windows
Thumbs.db
desktop.ini

# Temp files
*.tmp
*.bak

# everything else
*.zip

# Allow
!templates/
!templates/boss_wiki.db
!templates/hud_settings.json
!templates/keybinds.json
!templates/world_order.json